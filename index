<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Simple Blog with Image Slider</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      margin: 0;
      padding: 0;
      background: #f5f5f5;
    }

    header {
      background: #333;
      color: white;
      padding: 1em;
      text-align: center;
    }

    .container {
      max-width: 800px;
      margin: auto;
      padding: 20px;
      background: white;
    }

    .blog-post {
      margin-bottom: 40px;
    }

    .blog-post h2 {
      margin-bottom: 10px;
    }

    .slider {
      position: relative;
      width: 100%;
      height: 300px;
      overflow: hidden;
      margin-bottom: 20px;
    }

    .slides {
      display: flex;
      flex-direction: column;
      transition: transform 1s ease-in-out;
    }

    .slides img {
      width: 100%;
      height: 300px;
      object-fit: cover;
    }
  </style>
</head>
<body>
  <header>
    <h1>My Simple Blog</h1>
  </header>
  <div class="container">
    <div class="slider">
      <div class="slides" id="slides">
        <img src="https://via.placeholder.com/800x300?text=Image+1" alt="Image 1">
        <img src="https://via.placeholder.com/800x300?text=Image+2" alt="Image 2">
        <img src="https://via.placeholder.com/800x300?text=Image+3" alt="Image 3">
      </div>
    </div>

    <div class="blog-post">
      <h2>Welcome to My Blog</h2>
      <p>This is a simple blog layout with an image slider that scrolls down vertically.</p>
    </div>

    <div class="blog-post">
      <h2>Another Post</h2>
      <p>More content will be added here later. Stay tuned!</p>
    </div>
  </div>

  <script>
    let currentIndex = 0;
    const slides = document.getElementById("slides");
    const totalSlides = slides.children.length;

    setInterval(() => {
      currentIndex = (currentIndex + 1) % totalSlides;
      slides.style.transform = `translateY(-${currentIndex * 300}px)`;
    }, 3000);
  </script>
</body>
</html>
